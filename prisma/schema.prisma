generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String       @default("")
  discountType   DiscountType
  discountValue  Float
  maximumDiscount Float?
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id         String     @id @default(cuid())
  supabaseId String     @unique
  name       String
  email      String     @unique
  role       UserRole   @default(CUSTOMER)
  phone      String?
  orders     Order[]
  reviews    Review[]
  wishlist   Wishlist[]
  cartItems  CartItem[]
  addresses  Address[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String
  longDescription String?
  origin          String?
  price           Float
  stock           Int
  roastLevel      String
  flavorNotes     String[]
  weightOptions   Json
  imageUrl        String
  images          String[]
  featured        Boolean     @default(false)
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        Wishlist[]
  cartItems       CartItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  weight    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, productId, weight])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  street    String
  city      String
  isDefault Boolean @default(false)
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  user                User?       @relation(fields: [userId], references: [id])
  email               String      @default("")
  status              OrderStatus @default(PENDING)
  paymentStatus       String      @default("UNPAID")
  paymentMethod       String?
  paymobTransactionId String?
  paymobOrderId       Int?
  total               Float
  subtotal            Float         @default(0)
  shippingFee         Float         @default(60)
  discountAmount      Float         @default(0)
  couponId            String?
  coupon              Coupon?       @relation(fields: [couponId], references: [id])
  couponCode          String        @default("")
  shippingAddress     Json
  firstName           String      @default("")
  lastName            String      @default("")
  governorate         String      @default("")
  city                String      @default("")
  address             String      @default("")
  latitude            Float?
  longitude           Float?
  phone               String
  notes               String?
  items               OrderItem[]
  statusLogs          OrderStatusLog[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([paymobOrderId])
  @@index([paymentStatus])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  weight    String?

  @@index([orderId])
}

model OrderStatusLog {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  fromStatus   String?
  toStatus     String
  fromPayment  String?
  toPayment    String?
  note         String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
