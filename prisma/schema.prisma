generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id         String     @id @default(cuid())
  supabaseId String     @unique
  name       String
  email      String     @unique
  role       UserRole   @default(CUSTOMER)
  phone      String?
  orders     Order[]
  reviews    Review[]
  wishlist   Wishlist[]
  cartItems  CartItem[]
  addresses  Address[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String
  longDescription String?
  origin          String?
  price           Float
  stock           Int
  roastLevel      String
  flavorNotes     String[]
  weightOptions   Json
  imageUrl        String
  images          String[]
  featured        Boolean     @default(false)
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        Wishlist[]
  cartItems       CartItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  weight    String?
  createdAt DateTime @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  street    String
  city      String
  isDefault Boolean @default(false)
}

model Order {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  status              OrderStatus @default(PENDING)
  paymentStatus       String      @default("UNPAID")
  paymentMethod       String?
  paymobTransactionId String?
  paymobOrderId       Int?
  total               Float
  shippingAddress     Json
  firstName           String      @default("")
  lastName            String      @default("")
  governorate         String      @default("")
  city                String      @default("")
  address             String      @default("")
  latitude            Float?
  longitude           Float?
  phone               String
  notes               String?
  items               OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  weight    String?
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}
